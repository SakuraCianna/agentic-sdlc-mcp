{
  "name": "agentic-sdlc-mcp",
  "version": "1.10.0",
  "mcpName": "io.github.SakuraCianna/agentic-sdlc-mcp",
  "description": "An MCP Server acting as an Agentic SDLC Control Plane — helps AI coding agents plan, create, test, review, secure, and release software following GitHub Agentic AI best practices.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentic-sdlc-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "evaluation/schema.json",
    "README.md",
    "server.json",
    ".env.example"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check:line-endings": "node scripts/check-line-endings.mjs",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest --exclude src/__tests__/mcp-stdio-process.integration.test.ts",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run src/__tests__/config.integration.test.ts src/__tests__/mcp-protocol.integration.test.ts src/__tests__/mcp-era.integration.test.ts src/__tests__/mcp-tool-runtime.integration.test.ts src/__tests__/mcp-tool-contract.integration.test.ts src/__tests__/mcp-http-runtime.integration.test.ts src/__tests__/mcp-stdio-process.integration.test.ts",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage",
    "preeval:score": "npm run build",
    "eval:score": "vitest run src/__tests__/evaluation/scorer.test.ts",
    "eval:deterministic": "node scripts/run-deterministic-evaluation.mjs",
    "eval:budgets": "node scripts/run-deterministic-evaluation.mjs --group budgets",
    "eval:faults": "node scripts/run-deterministic-evaluation.mjs --group faults",
    "eval:ci": "npm run build && npm run eval:deterministic -- --group score && npm run eval:deterministic -- --group selection && npm run eval:deterministic -- --group critical && npm run eval:budgets && npm run eval:faults && node scripts/write-evaluation-ci-summary.mjs",
    "contracts:generate": "npm run build && node scripts/generate-mcp-contract.mjs --tag v1.9.0 --expected-commit 3e1cdbb2d591ba482903f53579f1f76cc95ff1c4 --release-url https://github.com/SakuraCianna/agentic-sdlc-mcp/releases/tag/v1.9.0 --output contracts/mcp/v1.9.0.json --update",
    "contracts:check": "npm run build && node scripts/check-mcp-contract.mjs",
    "contracts:verify-baseline": "npm run build && node scripts/verify-mcp-baseline.mjs",
    "contracts:inspector:install": "npm ci --prefix tools/inspector --ignore-scripts --no-audit --no-fund",
    "precontracts:inspector:stdio": "npm run build",
    "contracts:inspector:stdio": "node scripts/run-inspector-contracts.mjs",
    "precontracts:inspector:http": "npm run build",
    "contracts:inspector:http": "node scripts/run-inspector-contracts.mjs --transport http",
    "contracts:conformance:install": "npm ci --prefix tools/conformance --ignore-scripts --no-audit --no-fund",
    "precontracts:conformance:pilot": "npm run build",
    "contracts:conformance:pilot": "node scripts/run-conformance-pilot.mjs",
    "smoke": "node dist/index.js --smoke",
    "prepublishOnly": "npm run build && node scripts/verify-mcp-baseline.mjs && node scripts/check-mcp-contract.mjs && npm run typecheck && npm run test && npm run smoke"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "github",
    "sdlc",
    "agentic",
    "ai",
    "devops",
    "claude"
  ],
  "author": "SakuraCianna",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SakuraCianna/agentic-sdlc-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/SakuraCianna/agentic-sdlc-mcp/issues"
  },
  "homepage": "https://github.com/SakuraCianna/agentic-sdlc-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
